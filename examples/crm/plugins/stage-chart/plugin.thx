// A second plugin for the pipeline widget. It is deployed with the others but is not in the layout: a user switches
// to it in the plugin browser. It draws with the implementor's own chart, exposed to plugins as @app/format (L3).
//
// Derived by the build (P2):
//   required: deals.read   (listDeals)
//   library:  @app/format

import { definePlugin, useQuery } from "thixo/plugin";
import { Card } from "thixo/ui";
import { BarChart } from "@app/format";
import { dashboardPipeline } from "@app/slots";
import { listDeals } from "@app/sdk";

const STAGES = ["lead", "qualified", "proposal", "negotiation", "closed"];

export default definePlugin(
  dashboardPipeline,
  {
    id: "plg_crm_stage_chart",
    name: "Stage chart",
    description: "Deals per stage as a bar chart.",
  },
  function StageChart() {
    const list = useQuery(listDeals);
    const data = STAGES.map((stage) => ({ label: stage, value: (list.data ?? []).filter((d) => d.stage === stage).length }));
    return (
      <Card title="Deals per stage">
        <BarChart data={data} />
      </Card>
    );
  },
);
