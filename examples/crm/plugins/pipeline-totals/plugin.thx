// A dashboard widget that shows more to a user who may call the finance endpoints, and carries on without it for
// one who may not (P2, P4).
//
// Derived by the build (P2):
//   required: deals.read     (listDeals)
//   optional: finance.read   (listDealValues, getRevenue)
//   library:  @app/format

import { definePlugin, useCan, useQuery } from "thixo/plugin";
import { Button, Card, Stack, Text } from "thixo/ui";
import { formatMoney } from "@app/format";
import { dashboardPipeline } from "@app/slots";
import { listDeals } from "@app/sdk";
import { getRevenue, listDealValues } from "@app/sdk/optional";

const STAGES = ["lead", "qualified", "proposal", "negotiation", "closed"];

export default definePlugin(
  dashboardPipeline,
  {
    id: "plg_crm_pipeline_totals",
    name: "Pipeline totals",
    description: "How many deals sit in each stage, with their value and revenue if you may see them.",
  },
  function PipelineTotals({ emit }) {
    const list = useQuery(listDeals);
    const values = useQuery(listDealValues);
    const revenue = useQuery(getRevenue);
    const canSeeMoney = useCan(getRevenue);

    const valueIn = (stage: string) => {
      const ids = (list.data ?? []).filter((d) => d.stage === stage).map((d) => d.id);
      return (values.data ?? []).filter((v) => ids.includes(v.dealId)).reduce((sum, v) => sum + v.value, 0);
    };

    return (
      <Card title="Pipeline">
        <Stack gap="sm">
          {STAGES.map((stage) => {
            const count = (list.data ?? []).filter((d) => d.stage === stage).length;
            return (
              <Text key={stage}>{canSeeMoney ? `${stage}: ${count} deals, ${formatMoney(valueIn(stage))}` : `${stage}: ${count} deals`}</Text>
            );
          })}
          {revenue.data && <Text weight="bold">{`Closed revenue ${formatMoney(revenue.data.closed)}`}</Text>}
          {revenue.data && <Text tone="muted">{`Open pipeline ${formatMoney(revenue.data.open)}`}</Text>}
          {!canSeeMoney && <Text tone="muted">Values are shown to people who hold finance.read.</Text>}
          <Button variant="secondary" onClick={() => emit.openStage({ stage: "lead" })}>
            Open the pipeline
          </Button>
        </Stack>
      </Card>
    );
  },
);
