// The panel beside a picked contact, with a child slot (S13) for whatever a user wants under it.
//
// Derived by the build (P2):
//   required: contacts.read, companies.read   (getContact, getCompany)
//   services: navigate, copyToClipboard, toast
//   library:  @app/format

import { ChildSlot, definePlugin, useQuery } from "thixo/plugin";
import { Button, Card, Stack, Text } from "thixo/ui";
import { copyToClipboard, navigate, toast } from "thixo/services";
import { formatDay } from "@app/format";
import { contactDetail, contactNotes } from "@app/slots";
import { getCompany, getContact } from "@app/sdk";

export default definePlugin(
  contactDetail,
  {
    id: "plg_crm_contact_detail",
    name: "Contact detail",
    description: "A contact's details, their company, a button to copy the email, and a slot for notes.",
  },
  function ContactDetail({ context, emit }) {
    const contact = useQuery(getContact, { id: context.contactId });
    const company = useQuery(getCompany, { id: contact.data?.companyId ?? "" });

    async function copyEmail(email: string) {
      try {
        await copyToClipboard(email);
        toast(`Copied ${email}`, { tone: "success" });
      } catch (error) {
        toast("The browser would not copy", { tone: "danger" });
      }
    }

    if (!contact.data) return <Text tone="muted">{contact.error ? contact.error.message : "Loading…"}</Text>;
    const c = contact.data;

    return (
      <Stack gap="md">
        <Card title={c.name}>
          <Stack gap="sm">
            <Text>{c.title}</Text>
            <Text tone="muted">{c.email}</Text>
            <Text tone="muted">{`Last contact ${formatDay(c.lastContact)} · team ${c.team}`}</Text>
            <Stack direction="row" gap="sm" wrap>
              <Button variant="secondary" onClick={() => copyEmail(c.email)}>
                Copy email
              </Button>
              {company.data && (
                <Button variant="secondary" onClick={() => emit.openCompany({ companyId: c.companyId })}>
                  {company.data.name}
                </Button>
              )}
              <Button variant="secondary" onClick={() => navigate("/contacts")}>
                Back to contacts
              </Button>
            </Stack>
          </Stack>
        </Card>
        <ChildSlot is={contactNotes} context={{ contactId: context.contactId }} />
      </Stack>
    );
  },
);
