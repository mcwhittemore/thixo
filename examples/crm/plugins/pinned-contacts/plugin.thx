// A dashboard widget with a private store.
//
// Derived by the build (P2):
//   required: contacts.read, thixo.data.read, thixo.data.write   (listContacts, the store)
//   data:     private store pins { contactId: string }

import { css, definePlugin, useQuery, useStoreList } from "thixo/plugin";
import { Button, Card, Select, Stack, Text } from "thixo/ui";
import { dashboardPinned } from "@app/slots";
import { listContacts } from "@app/sdk";
import { pins } from "./data";

export default definePlugin(
  dashboardPinned,
  {
    id: "plg_crm_pinned_contacts",
    name: "Pinned contacts",
    description: "Contacts you keep close. The pins are yours alone.",
  },
  function PinnedContacts({ emit }) {
    const people = useQuery(listContacts);
    const pinned = useStoreList(pins);
    const row = css({ display: "flex", gap: 8, alignItems: "center" });

    const nameOf = (id: string) => people.data?.find((c) => c.id === id)?.name ?? id;
    const taken = pinned.records.map((r) => r.contactId);
    const options = (people.data ?? []).filter((c) => !taken.includes(c.id)).map((c) => ({ value: c.id, label: c.name }));

    return (
      <Card title="Pinned contacts">
        <Stack gap="sm">
          {pinned.records.length === 0 && <Text tone="muted">Nothing pinned yet.</Text>}
          {pinned.records.map((r) => (
            <div key={r.id} className={row}>
              <Button variant="secondary" onClick={() => r.contactId && emit.open({ contactId: r.contactId })}>
                {nameOf(r.contactId ?? "")}
              </Button>
              <button type="button" aria-label={`Unpin ${nameOf(r.contactId ?? "")}`} onClick={() => pinned.remove(r.id)}>
                Unpin
              </button>
            </div>
          ))}
          <Select
            label="Pin a contact"
            value={undefined}
            placeholder="Choose…"
            options={options}
            onChange={(contactId) => pinned.create({ contactId })}
          />
        </Stack>
      </Card>
    );
  },
);
