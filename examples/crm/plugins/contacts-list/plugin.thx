// The contacts page. Raw elements and css() for the table, thixo/ui for the controls.
//
// Derived by the build (P2):
//   required: contacts.read, companies.read   (listContacts, listCompanies)
//   optional: contacts.write                  (createContact: the add form is grayed out without it)
//             admin.export                    (exportContacts: "Export all" is grayed out without it)
//   services: download, toast
//   library:  @app/format

import { css, definePlugin, useCan, useQuery, useState } from "thixo/plugin";
import { Badge, Button, Select, Stack, Text, TextInput } from "thixo/ui";
import { download, toast } from "thixo/services";
import { formatDay } from "@app/format";
import { contacts } from "@app/slots";
import { listCompanies, listContacts } from "@app/sdk";
import { createContact, exportContacts } from "@app/sdk/optional";

function cell(value: string) {
  return `"${value.split('"').join('""')}"`;
}

export default definePlugin(
  contacts,
  {
    id: "plg_crm_contacts_list",
    name: "Contacts list",
    description: "Every contact with their company and team. Search, add a contact, download what is on screen.",
  },
  function ContactsList({ emit }) {
    const people = useQuery(listContacts);
    const companyList = useQuery(listCompanies);
    const canCreate = useCan(createContact);
    const canExport = useCan(exportContacts);
    const [filter, setFilter] = useState("");
    const [name, setName] = useState("");
    const [email, setEmail] = useState("");
    const [companyId, setCompanyId] = useState<string | undefined>(undefined);

    const table = css({ width: "100%", borderCollapse: "collapse" });
    const head = css({ textAlign: "left", padding: 6, borderBottom: "1px solid #8884" });
    const data = css({ padding: 6, borderBottom: "1px solid #8882" });

    const companyName = (id: string) => companyList.data?.find((c) => c.id === id)?.name ?? "";
    const needle = filter.toLowerCase();
    const shown = (people.data ?? []).filter((c) => `${c.name} ${c.email} ${companyName(c.companyId)}`.toLowerCase().includes(needle));

    function downloadShown() {
      const lines = ["name,email,company,team", ...shown.map((c) => [c.name, c.email, companyName(c.companyId), c.team].map(cell).join(","))];
      download("contacts.csv", lines.join("\n"), "text/csv");
      toast(`Downloaded ${shown.length} contacts`, { tone: "success" });
    }

    async function exportEverything() {
      const csv = await exportContacts();
      download("all-contacts.csv", csv, "text/csv");
      toast("Exported every contact", { tone: "success" });
    }

    async function add() {
      const chosen = companyId ?? companyList.data?.[0]?.id;
      if (!name || !email || !chosen) return;
      await createContact({ name, email, companyId: chosen });
      setName("");
      setEmail("");
      people.refresh();
      toast(`Added ${name}`, { tone: "success" });
    }

    return (
      <Stack gap="md">
        <Stack direction="row" gap="sm" align="end" wrap>
          <TextInput label="Search contacts" value={filter} onChange={setFilter} />
          <Button variant="secondary" onClick={downloadShown}>
            Download CSV
          </Button>
          <Button variant="secondary" disabled={!canExport} onClick={exportEverything}>
            Export all
          </Button>
        </Stack>

        {people.loading && <Text tone="muted">Loading…</Text>}
        {people.error && <Text tone="danger">{people.error.message}</Text>}

        <table className={table}>
          <thead>
            <tr>
              <th className={head}>Name</th>
              <th className={head}>Title</th>
              <th className={head}>Company</th>
              <th className={head}>Team</th>
              <th className={head}>Last contact</th>
            </tr>
          </thead>
          <tbody>
            {shown.map((c) => (
              <tr key={c.id}>
                <td className={data}>
                  <Button variant="secondary" onClick={() => emit.select({ contactId: c.id })}>
                    {c.name}
                  </Button>
                </td>
                <td className={data}>{c.title}</td>
                <td className={data}>{companyName(c.companyId)}</td>
                <td className={data}>
                  <Badge tone="info">{c.team}</Badge>
                </td>
                <td className={data}>{formatDay(c.lastContact)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <Stack direction="row" gap="sm" align="end" wrap>
          <TextInput label="New contact name" value={name} onChange={setName} disabled={!canCreate} />
          <TextInput label="New contact email" value={email} onChange={setEmail} onSubmit={add} disabled={!canCreate} />
          <Select
            label="Company"
            value={companyId ?? companyList.data?.[0]?.id}
            options={(companyList.data ?? []).map((c) => ({ value: c.id, label: c.name }))}
            onChange={setCompanyId}
            disabled={!canCreate}
          />
          <Button disabled={!canCreate} onClick={add}>
            Add contact
          </Button>
        </Stack>
      </Stack>
    );
  },
);
