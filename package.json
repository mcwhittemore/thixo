{
  "name": "thixo-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "bench"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/cli packages/react",
    "test": "npm run test -w @thixo/core -w @thixo/cli -w thixo-bench",
    "typecheck": "tsc -b packages/core packages/cli packages/react && tsc -p bench",
    "bench": "npm run bench -w thixo-bench --"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
