{
  "name": "thixo-bench",
  "private": true,
  "type": "module",
  "description": "Agents try to get past thixo: write a program that reaches the page, the network or a secret. A browser reports whether it did.",
  "scripts": {
    "bench": "node --conditions=thixo-source --import tsx src/run.ts",
    "test": "node --conditions=thixo-source --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "*",
    "thixo": "*",
    "thixo-cli": "*",
    "thixo-react": "*",
    "zod": "*"
  }
}
