{
  "name": "@thixo/cli",
  "version": "0.1.1",
  "description": "The thixo command: compile a folder of .thx files to one JavaScript module.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcwhittemore/thixo.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/mcwhittemore/thixo#readme",
  "type": "module",
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "thixo": "bin/thixo.js"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --conditions=thixo-source --import tsx --test \"test/**/*.test.ts\""
  },
  "exports": {
    ".": {
      "thixo-source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "dependencies": {
    "@thixo/core": "0.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
