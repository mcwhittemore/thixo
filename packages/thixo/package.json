{
  "name": "thixo",
  "version": "0.1.0",
  "description": "A language that looks like TypeScript and React, and compiles to JavaScript that can't reach the page, the network or anything it wasn't handed.",
  "type": "module",
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "thixo": "./bin/thixo.js"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./ts-api": {
      "types": "./dist/compiler/ts-api.d.ts",
      "default": "./dist/compiler/ts-api.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "dependencies": {
    "typescript-js-api": "npm:typescript@~6.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
