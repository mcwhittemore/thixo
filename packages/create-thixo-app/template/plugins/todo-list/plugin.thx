// The default plugin for the main slot: the list of todos. Every user has it.
//
// Its scopes are not written anywhere. The build reads them from these imports:
//   required: todos.read, todos.write   (listTodos, createTodo, updateTodo, from @app/sdk)
//   optional: todos.delete              (deleteTodo, from @app/sdk/optional)
// A user who lacks a required scope doesn't get the plugin. A user who lacks an optional one does, and useCan tells
// the plugin, so it grays the action out.

import { definePlugin, useCan, useQuery, useState } from "thixo/plugin";
import { Button, Checkbox, Stack, Text, TextInput } from "thixo/ui";
import { main } from "@app/slots";
import { createTodo, listTodos, updateTodo } from "@app/sdk";
import { deleteTodo } from "@app/sdk/optional";

export default definePlugin(
  main,
  {
    id: "plg_todo_list",
    name: "Todo list",
    description: "Every todo in one list. Add, tick off and delete.",
  },
  function TodoList({ emit }) {
    const todos = useQuery(listTodos);
    const [title, setTitle] = useState("");
    const canDelete = useCan(deleteTodo);

    async function add() {
      await createTodo({ title });
      setTitle("");
      todos.refresh();
    }

    return (
      <Stack gap="md">
        <TextInput value={title} onChange={setTitle} onSubmit={add} placeholder="Add a todo" />
        {todos.loading && <Text tone="muted">Loading…</Text>}
        {todos.error && <Text tone="danger">{todos.error.message}</Text>}

        {todos.data?.map((todo) => (
          <Stack key={todo.id} direction="row" gap="sm">
            {/* Without a label a Checkbox is named "Done" for a screen reader; give one to any other checkbox. */}
            <Checkbox checked={todo.done} onChange={(done) => updateTodo({ id: todo.id, done }).then(todos.refresh)} />
            <Button variant="secondary" onClick={() => emit.select({ todoId: todo.id })}>
              {todo.title}
            </Button>
            {/* Grayed out for a user who can't delete. */}
            <Button variant="danger" disabled={!canDelete} onClick={() => deleteTodo({ id: todo.id }).then(todos.refresh)}>
              Delete
            </Button>
          </Stack>
        ))}
      </Stack>
    );
  },
);
