// The default plugin for the todo-detail panel: the selected todo and whether it is done.
//
// The build reads its scopes from the imports (required: todos.read, from getTodo).

import { definePlugin, useQuery } from "thixo/plugin";
import { Card, Text } from "thixo/ui";
import { todoDetail } from "@app/slots";
import { getTodo } from "@app/sdk";

export default definePlugin(
  todoDetail,
  {
    id: "plg_todo_info",
    name: "Todo info",
    description: "Shows the title and whether the selected todo is done.",
  },
  function TodoInfo({ context }) {
    const todo = useQuery(getTodo, { id: context.todoId });
    if (!todo.data) return <Text tone="muted">Loading…</Text>;
    return (
      <Card title={todo.data.title}>
        <Text tone={todo.data.done ? "success" : "muted"}>{todo.data.done ? "Done" : "Open"}</Text>
      </Card>
    );
  },
);
