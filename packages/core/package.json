{
  "name": "@thixo/core",
  "version": "0.1.0",
  "description": "The thixo compiler and runtime, to embed in a build or a server: a language that reads as TypeScript and React and compiles to JavaScript that can only reach what it was handed.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "exports": {
    ".": {
      "thixo-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "thixo-source": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./ts-api": {
      "thixo-source": "./src/compiler/ts-api.ts",
      "types": "./dist/compiler/ts-api.d.ts",
      "default": "./dist/compiler/ts-api.js"
    },
    "./contract": {
      "thixo-source": "./src/contract.ts",
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "dependencies": {
    "typescript-js-api": "npm:typescript@~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
